{
  "name": "arcadestrike-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node -e \"const {execSync}=require('child_process');execSync('npx prisma db push --schema=prisma/schema.prisma --accept-data-loss',{stdio:'inherit',env:process.env});\" && node dist/index.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.0",
    "@colyseus/monitor": "^0.15.0",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.0",
    "@fastify/cors": "^9.0.0",
    "@prisma/client": "^5.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.0.0",
    "ioredis": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
